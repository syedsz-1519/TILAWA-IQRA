# Backend API Configuration

# Environment
ENVIRONMENT=dev

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://tilawa.app

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tilawa_dev
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/tilawa_dev

# Better Auth
BETTER_AUTH_SECRET=dev-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:8000

# ML Models
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Logging
LOG_LEVEL=INFO
