# TILAWA Backend Configuration

# ========================================
# REQUIRED: Database Connection
# ========================================

# PostgreSQL database connection string
# Format: postgresql://user:password@host:port/database
# 
# Must be the SAME as frontend DATABASE_URL
# Get from: Neon.tech, Railway, AWS RDS, or Render
#
# Example: postgresql://user:pass@db.neon.tech:5432/tilawa_prod
DATABASE_URL=postgresql://user:password@host:5432/tilawa

# ========================================
# REQUIRED: Authentication Secret
# ========================================

# Better Auth secret (32+ characters, random)
# Must be the SAME as frontend BETTER_AUTH_SECRET
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your-secure-random-secret-min-32-chars

# ========================================
# REQUIRED: CORS Configuration
# ========================================

# Comma-separated list of allowed origins
# Must include your frontend URL(s)
#
# Examples:
# - https://tilawa.vercel.app
# - https://tilawa-staging.vercel.app
# - http://localhost:3000 (for development)
#
# Use: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,https://tilawa.vercel.app

# ========================================
# Environment Configuration
# ========================================

# Environment: dev, staging, or production
ENVIRONMENT=production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# Optional: AI/ML Features
# ========================================

# Whisper model for audio transcription
# Options: tiny, base, small, medium, large
# Larger = better accuracy but slower
WHISPER_MODEL=base

# Device for ML inference
# Options: cpu, cuda (for GPU)
WHISPER_DEVICE=cpu

# ========================================
# Optional: Server Configuration
# ========================================

# Server port (usually 8000)
# PORT=8000

# Server host
# HOST=0.0.0.0

# ========================================
# DEVELOPMENT ONLY (Local Setup)
# ========================================

# For local development, use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tilawa_dev
# BETTER_AUTH_SECRET=dev-secret-only-for-local-development
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# ENVIRONMENT=development
# LOG_LEVEL=DEBUG
