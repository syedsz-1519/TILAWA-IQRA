# Backend API Configuration

# Environment
ENVIRONMENT=dev

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://tilawa.app

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/tilawa
POSTGRES_URL=postgresql://user:password@localhost:5432/tilawa

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:8000

# ML Models
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Logging
LOG_LEVEL=INFO
