# Database Configuration
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/tilawa

# Authentication
# Secret key for Better Auth (minimum 32 characters, required)
BETTER_AUTH_SECRET=your-secret-key-here-minimum-32-characters-required
# Better Auth URL (optional, defaults to http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# Server Configuration
# Node environment (development, production, test)
NODE_ENV=development
# Port to run the server on (default: 8000)
PORT=8000
# Frontend URL for CORS (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
