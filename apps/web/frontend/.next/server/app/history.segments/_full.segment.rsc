35:[["$","title","0",{"children":"History of Quran — Tarikh-e-Quran | TILAWA | TILAWA"}],["$","meta","1",{"name":"description","content":"The complete journey of the Holy Quran: from the first revelation in the Cave of Hira to the standardized Mushaf-e-Uthmani. Tarikh-e-Quran on TILAWA."}],["$","link","2",{"rel":"manifest","href":"/manifest.webmanifest","crossOrigin":"$undefined"}],["$","meta","3",{"name":"robots","content":"index, follow"}],["$","meta","4",{"property":"og:title","content":"TILAWA – Quranic Recitation & Learning"}],["$","meta","5",{"property":"og:description","content":"Read, listen, and learn the Holy Quran with tajweed guidance, daily ayah, duas, hadith and Qibla."}],["$","meta","6",{"property":"og:url","content":"https://tilawaa.vercel.app"}],["$","meta","7",{"property":"og:site_name","content":"TILAWA"}],["$","meta","8",{"property":"og:image","content":"https://tilawaa.vercel.app/images/og-image.png"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:alt","content":"TILAWA – From Iqra to Tilawa"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"TILAWA – Quranic Recitation & Learning"}],["$","meta","15",{"name":"twitter:description","content":"Read, listen, and learn the Holy Quran with tajweed guidance, daily ayah, duas, hadith and Qibla."}],["$","meta","16",{"name":"twitter:image","content":"https://tilawaa.vercel.app/images/og-image.png"}],["$","link","17",{"rel":"icon","href":"/icon-light-32x32.png","media":"(prefers-color-scheme: light)"}],["$","link","18",{"rel":"icon","href":"/icon-dark-32x32.png","media":"(prefers-color-scheme: dark)"}],["$","link","19",{"rel":"apple-touch-icon","href":"/apple-icon.png"}],["$","$L36","20",{}]]
