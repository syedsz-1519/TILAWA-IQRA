# TILAWA Frontend - Production Environment
# Set these values during Vercel deployment

# Backend API URL (will be set to Railway backend)
NEXT_PUBLIC_API_URL=https://tilawa-backend.railway.app

# Frontend Base URL (will be auto-set by Vercel)
NEXT_PUBLIC_BETTER_AUTH_URL=https://tilawa-iqra.vercel.app

# Quran APIs (keep these - public endpoints)
NEXT_PUBLIC_QURAN_API_BASE=https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/editions
NEXT_PUBLIC_ALQURAN_CLOUD_API=https://api.alquran.cloud/v1

# Audio CDNs
NEXT_PUBLIC_MP3QURAN_CDN=https://cdn.alquran.cloud/quran
NEXT_PUBLIC_EVERYAYAH_CDN=https://everyayah.com/data/Yasser_Ad-Dossary

# Feature flags
NEXT_PUBLIC_ENABLE_BATTLES=true
NEXT_PUBLIC_ENABLE_ML_SCORING=true
NEXT_PUBLIC_ENABLE_TAJWEED_VISUALIZER=true

# Logging
NEXT_PUBLIC_LOG_LEVEL=info
