# ==============================================================================
# TILAWA Monorepo Environment Configuration Template
# Copy to respective application .env files (e.g. apps/web/frontend/.env.local, apps/backend/server/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web/frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_QURAN_API_BASE=https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/editions
NEXT_PUBLIC_ALQURAN_CLOUD_API=https://api.alquran.cloud/v1
NEXT_PUBLIC_MP3QURAN_CDN=https://api.alquran.cloud/quran
NEXT_PUBLIC_EVERYAYAH_CDN=https://everyayah.com/data/Yasser_Ad-Dossary

# Feature Flags
NEXT_PUBLIC_ENABLE_BATTLES=false
NEXT_PUBLIC_ENABLE_ML_SCORING=false
NEXT_PUBLIC_ENABLE_TAJWEED_VISUALIZER=true

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (apps/backend/server/.env)
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://tilawaa.vercel.app

# Database (MongoDB Atlas URI)
DATABASE_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/tilawa?retryWrites=true&w=majority

# JWT & Authentication
JWT_SECRET=your_jwt_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email Provider (Optional: Resend / SMTP)
RESEND_API_KEY=
EMAIL_FROM=no-reply@tilawa.app

# OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=