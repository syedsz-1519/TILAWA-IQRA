# TILAWA Frontend - Production Environment
# These environment variables should be set in Vercel dashboard
# Settings → Environment Variables

# Production API
NEXT_PUBLIC_API_URL=https://api.tilawa.app

# Production Better Auth
NEXT_PUBLIC_BETTER_AUTH_URL=https://tilawa.app

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=<your-analytics-id>

# Production database
DATABASE_URL=<vercel-secret>

# Better Auth Secret (MUST be different from dev!)
BETTER_AUTH_SECRET=<vercel-secret>

# Disable unnecessary features in production
NEXT_PUBLIC_ENABLE_ML_SCORING=true
NEXT_PUBLIC_ENABLE_BATTLES=true
