# TILAWA Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# ============ API Configuration ============
# Backend API base URL (for development)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============ Authentication ============
# Better Auth configuration
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_API_PREFIX=/api/auth

# ============ External APIs ============
# Quran content APIs
NEXT_PUBLIC_QURAN_API_BASE=https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1
NEXT_PUBLIC_ALQURAN_CLOUD_API=https://api.alquran.cloud/v1

# Audio CDNs
NEXT_PUBLIC_MP3QURAN_CDN=https://server11.mp3quran.net
NEXT_PUBLIC_EVERYAYAH_CDN=https://everyayah.com/data

# ============ Analytics & Monitoring ============
# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ============ Feature Flags ============
NEXT_PUBLIC_ENABLE_BATTLES=true
NEXT_PUBLIC_ENABLE_ML_SCORING=false
NEXT_PUBLIC_ENABLE_TAJWEED_VISUALIZER=false

# ============ Build Configuration ============
# Set to true to skip TypeScript checking during build (not recommended)
SKIP_ENV_VALIDATION=false

# ============ Development Only ============
# Uncomment in development for debugging
# DEBUG=tilawa:*
# NEXT_PUBLIC_LOG_LEVEL=debug
