# TILAWA Frontend - Local Development Environment
# ================================================
#
# Copy this file to: frontend/.env.local
# Then fill in the values below
#
# These variables are for LOCAL DEVELOPMENT ONLY
# For production, use .env.production.example

# ========================================
# LOCAL: Frontend & Backend URLs
# ========================================

# Local development frontend URL
NEXT_PUBLIC_VERCEL_URL=localhost:3000

# Local backend API (if running separately)
# Change port if your backend runs on a different port
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Better Auth URL
# Should match your frontend URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ========================================
# LOCAL: Database Configuration
# ========================================

# Local PostgreSQL connection
# Default for local: postgresql://postgres:postgres@localhost:5432/tilawa_dev
# 
# If you're using Docker:
# docker run -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=tilawa_dev -p 5432:5432 postgres
#
# Then use: postgresql://postgres:postgres@localhost:5432/tilawa_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tilawa_dev

# ========================================
# LOCAL: Authentication Secret
# ========================================

# For development, this can be any string (min 32 chars)
# Use: dev-secret-only-for-local-development
# Or generate a random one for testing
BETTER_AUTH_SECRET=dev-secret-only-for-local-development

# ========================================
# LOCAL: External APIs (usually same in dev & prod)
# ========================================

# Quran text API
NEXT_PUBLIC_QURAN_API_BASE=https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/editions

# Translations API
NEXT_PUBLIC_ALQURAN_CLOUD_API=https://api.alquran.cloud/v1

# Audio CDN
NEXT_PUBLIC_EVERYAYAH_CDN=https://everyayah.com/data/Yasser_Ad-Dossary

# ========================================
# LOCAL: Feature Flags (enable all for testing)
# ========================================

NEXT_PUBLIC_ENABLE_BATTLES=true
NEXT_PUBLIC_ENABLE_ML_SCORING=true
NEXT_PUBLIC_ENABLE_TAJWEED_VISUALIZER=true

# ========================================
# LOCAL: Debugging & Analytics
# ========================================

# Enable debug logging (optional)
NEXT_PUBLIC_LOG_LEVEL=debug

# App name (for console logs)
NEXT_PUBLIC_APP_NAME=TILAWA-DEV

# Environment indicator
NEXT_PUBLIC_ENVIRONMENT=development

# ========================================
# LOCAL: Setup Instructions
# ========================================
#
# 1. Install PostgreSQL (or use Docker)
# 2. Create local database:
#    createdb tilawa_dev
#
# 3. Apply schema:
#    psql -U postgres -d tilawa_dev < database/schema.sql
#
# 4. Copy this file to .env.local:
#    cp .env.local.example .env.local
#
# 5. If backend runs on different port, update NEXT_PUBLIC_API_URL
#
# 6. Start frontend:
#    pnpm dev
#
# 7. Visit: http://localhost:3000
#
# ========================================
# TROUBLESHOOTING LOCAL SETUP
# ========================================
#
# Build fails with "DATABASE_URL is not set":
#   → Copy this file to .env.local
#   → Verify DATABASE_URL is correct
#   → Check PostgreSQL is running
#
# Cannot connect to database:
#   → Check PostgreSQL is running: psql -U postgres
#   → Verify connection string: psql postgresql://postgres:postgres@localhost:5432/tilawa_dev
#
# Backend API returns 404:
#   → Make sure backend is running: python -m uvicorn main:app --reload
#   → Check NEXT_PUBLIC_API_URL matches backend port
#
# Auth returns errors:
#   → Check BETTER_AUTH_SECRET is set
#   → Verify DATABASE_URL is correct
#   → Check auth schema is applied: psql -d tilawa_dev -c "SELECT * FROM \"user\";"
#
