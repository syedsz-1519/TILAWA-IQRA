# TILAWA Frontend - Local Development Environment
# This file is used for LOCAL DEVELOPMENT ONLY
# Copy to .env.local and update

# Development API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Better Auth
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Development database (if needed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tilawa_dev

# Better Auth Secret (for development)
BETTER_AUTH_SECRET=dev-secret-key-change-in-production

# Enable debugging
# NEXT_PUBLIC_LOG_LEVEL=debug
